{
  "name": "CommerceOps AI - Guardrail Alert Flow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "guardrail-alert",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Guardrail Event Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [260, 300],
      "webhookId": "commerceops-guardrail-alert"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "is-blocked-or-flagged",
              "leftValue": "={{$json.body.action}}",
              "rightValue": "blocked",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      },
      "id": "filter-severity",
      "name": "Is Blocked or Flagged?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "alert-text",
              "name": "alert_text",
              "type": "string",
              "value": "=🛡️ CommerceOps AI Guardrail Alert\\nRail: {{$json.body.rail_type}}\\nAction: {{$json.body.action}}\\nSession: {{$json.body.session_id}}\\nDetail: {{$json.body.detail}}\\nTime: {{$json.body.occurred_at}}"
            }
          ]
        },
        "options": {}
      },
      "id": "format-alert",
      "name": "Format Alert Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [700, 220]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SLACK_INCOMING_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"text\": $json.alert_text } }}",
        "options": {}
      },
      "id": "post-to-slack",
      "name": "Post to Slack (Incoming Webhook)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [920, 220]
    }
  ],
  "connections": {
    "Guardrail Event Webhook": {
      "main": [[{ "node": "Is Blocked or Flagged?", "type": "main", "index": 0 }]]
    },
    "Is Blocked or Flagged?": {
      "main": [[{ "node": "Format Alert Message", "type": "main", "index": 0 }]]
    },
    "Format Alert Message": {
      "main": [[{ "node": "Post to Slack (Incoming Webhook)", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "active": false
}
