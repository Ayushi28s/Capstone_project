{
  "name": "CommerceOps AI - Scheduled Market Intelligence Report",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "weeks", "weeksInterval": 1, "triggerAtDay": [1], "triggerAtHour": 8 }]
        }
      },
      "id": "schedule-trigger",
      "name": "Every Monday 8am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [260, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "session-id",
              "name": "session_id",
              "type": "string",
              "value": "=n8n-weekly-{{$now.format('yyyy-MM-dd')}}"
            }
          ]
        },
        "options": {}
      },
      "id": "generate-session-id",
      "name": "Generate Session ID",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [480, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.COMMERCEOPS_API_BASE_URL }}/chat",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"message\": \"Summarize competitor pricing trends across all categories this quarter.\", \"session_id\": $json.session_id, \"customer_id\": \"STAFF-MARKETING-AUTOMATED\", \"order_id\": \"\" } }}",
        "options": {}
      },
      "id": "submit-market-intel-request",
      "name": "Submit Market Intel Request",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 300]
    },
    {
      "parameters": { "amount": 90, "unit": "seconds" },
      "id": "wait-for-agent",
      "name": "Wait for Deep Agent (plan->research->reflect)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [920, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.COMMERCEOPS_API_BASE_URL }}/chat/{{ $('Generate Session ID').item.json.session_id }}/response",
        "options": {}
      },
      "id": "fetch-report",
      "name": "Fetch Market Intel Report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1140, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SLACK_INCOMING_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"text\": \"📊 Weekly Market Intelligence Report is ready:\\n\\n\" + $json.final_response_text } }}",
        "options": {}
      },
      "id": "notify-report-ready",
      "name": "Post Report to Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1360, 300]
    }
  ],
  "connections": {
    "Every Monday 8am": {
      "main": [[{ "node": "Generate Session ID", "type": "main", "index": 0 }]]
    },
    "Generate Session ID": {
      "main": [[{ "node": "Submit Market Intel Request", "type": "main", "index": 0 }]]
    },
    "Submit Market Intel Request": {
      "main": [[{ "node": "Wait for Deep Agent (plan->research->reflect)", "type": "main", "index": 0 }]]
    },
    "Wait for Deep Agent (plan->research->reflect)": {
      "main": [[{ "node": "Fetch Market Intel Report", "type": "main", "index": 0 }]]
    },
    "Fetch Market Intel Report": {
      "main": [[{ "node": "Post Report to Slack", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "active": false
}
