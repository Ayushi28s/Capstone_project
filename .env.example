# Used by docker-compose.yml directly (not backend/.env or frontend/.env).
# Optional. If left blank, the "Post to Slack" step inside each n8n flow
# will simply fail that one node when it runs (visible in n8n's own
# execution log) — it does not affect the backend, the guardrail
# decision itself, or the rest of the system either way.
SLACK_INCOMING_WEBHOOK_URL=
