# --- LLM (OpenRouter only) ---
OPENROUTER_API_KEY=sk-or-v1-your-key-here
MODEL=anthropic/claude-sonnet-4.6

# --- Optional: LangSmith tracing ---
LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=commerceops-ai

# --- Optional: Arize Phoenix drift monitoring ---
# Requires the `phoenix` Docker service (docker-compose.yml) or your own
# arizephoenix/phoenix container running — this project only ever talks
# OTLP to it, it never launches Phoenix itself in-process.
PHOENIX_ENABLED=false
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
USE_REDIS_CHECKPOINTER=false

# --- Storage ---
DATA_DIR=./data
SQLITE_DB_PATH=./data/commerceops.db
CHECKPOINT_DB_PATH=./data/checkpoints.db
CHROMA_DIR=./data/chroma
KNOWLEDGE_GRAPH_PATH=./data/knowledge_graph.json
INTENT_ROUTER_MODEL_PATH=./data/intent_router.joblib
MCP_SQLITE_DB_PATH=./data/commerceops.db

# --- GitHub ecosystem MCP server (optional — not wired into any agent by default) ---
GITHUB_TOKEN=

# --- n8n workflow automation (Module 15) ---
# Set after importing n8n/guardrail_alert_flow.json and copying its
# webhook URL from the n8n UI (Guardrail Event Webhook node -> "Production URL").
N8N_GUARDRAIL_ALERT_WEBHOOK_URL=

# --- App ---
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*

# --- HITL threshold ---
REFUND_APPROVAL_THRESHOLD_USD=250.0

# --- RAG evaluation ---
RAGAS_FAITHFULNESS_THRESHOLD=0.90
