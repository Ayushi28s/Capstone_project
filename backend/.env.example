# --- LLM (OpenRouter only) ---
OPENROUTER_API_KEY=
MODEL=anthropic/claude-sonnet-4.6

# --- Optional: LangSmith tracing ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=northpeak-operations-copilot
LANGSMITH_PROJECT=northpeak-operations-copilot

# --- Optional: Arize Phoenix drift monitoring ---
PHOENIX_ENABLED=true
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces

# --- Prometheus: worker's own metrics server ---
WORKER_METRICS_PORT=9100

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
USE_REDIS_CHECKPOINTER=false

# --- Storage ---
DATA_DIR=./data
SQLITE_DB_PATH=./data/commerceops.db
CHECKPOINT_DB_PATH=./data/checkpoints.db
CHROMA_DIR=./data/chroma
KNOWLEDGE_GRAPH_PATH=./data/knowledge_graph.json
INTENT_ROUTER_MODEL_PATH=./data/intent_router.joblib
MCP_SQLITE_DB_PATH=./data/commerceops.db

# --- GitHub ecosystem MCP server (optional — not wired into any agent by default) ---
GITHUB_TOKEN=

# --- App ---
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*

# --- HITL threshold ---
REFUND_APPROVAL_THRESHOLD_USD=250.0

# --- RAG evaluation ---
RAGAS_FAITHFULNESS_THRESHOLD=0.90


